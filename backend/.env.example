# Окружение: development или production
APP_ENV=development
# URL базы данных (SQLite-файл по умолчанию)
DATABASE_URL=sqlite:///./database.db
# Каталог логов
LOG_DIR=./logs
# Уровень логирования
LOG_LEVEL=INFO
# Таймзона планировщика и группировки статистики по датам
APP_TIMEZONE=Europe/Moscow
# Разрешённые источники CORS, через запятую
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500,http://127.0.0.1:5500
# Токен для POST /api/admin/parse; пусто = эндпоинт выключен
ADMIN_TOKEN=
# Базовый URL Habr Career
HABR_CAREER_URL=https://career.habr.com
# Путь JSON-выдачи вакансий
HABR_API_PATH=/api/frontend/vacancies
# User-Agent парсера
HTTP_USER_AGENT=JobPulse/1.0 (+https://github.com/siosif963-gif/jobpulse)
# Таймаут HTTP-запроса, секунды
REQUEST_TIMEOUT_SECONDS=10
# Минимальная случайная задержка перед запросом, секунды
REQUEST_DELAY_MIN_SECONDS=1.0
# Максимальная случайная задержка перед запросом, секунды
REQUEST_DELAY_MAX_SECONDS=3.0
# Одновременных запросов к источнику
MAX_CONCURRENT_REQUESTS=2
# Лимит страниц на один поисковый запрос
MAX_PAGES_PER_QUERY=60
# Не парсить запрос повторно чаще, чем раз в N часов
MIN_REPARSE_HOURS=20
# Через сколько дней без обнаружения вакансия становится неактивной
STALE_AFTER_DAYS=7
# Включить планировщик
SCHEDULER_ENABLED=true
# Режим расписания: daily или interval
PARSING_SCHEDULE=daily
# Час запуска для daily (в APP_TIMEZONE)
PARSING_DAILY_HOUR=3
# Интервал в часах для interval
PARSING_INTERVAL_HOURS=24
# Если в БД 0 вакансий — запустить парсинг через 10 с после старта
PARSING_RUN_ON_STARTUP_IF_EMPTY=true
# Задержка повтора упавшего запуска, минуты
RETRY_DELAY_MINUTES=60
# Максимум повторов подряд
MAX_JOB_RETRIES=3
# Окно статистики по умолчанию, дни
DEFAULT_STATS_DAYS=30
